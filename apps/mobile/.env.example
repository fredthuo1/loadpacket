EXPO_PUBLIC_API_URL=
# HTTPS web origin only, for the existing browser-based password recovery flow.
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
# Public store SDK keys only: appl_ for iOS, goog_ for Android. Never secret API keys.
# Must exactly match the entitlement attached to the current offering's product.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
