DATABASE_URL=
NODE_ENV=development
# Optional locally: defaults to <API working directory>/storage/documents.
# REQUIRED in production: absolute path on a durable private volume, e.g. /data/loadpacket/documents.
# This is the documents directory itself, not its parent. No database keys change.
DOCUMENT_STORAGE_ROOT=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only admin secret, used solely for driver invitation operations.
SUPABASE_SECRET_KEY=
WEB_APP_URL=http://localhost:3000
# Server-only random secret (32+ characters) for expiring private download links.
DOCUMENT_DOWNLOAD_SECRET=
CORS_ORIGINS=http://localhost:3000
PORT=3001

# Optional development bootstrap; never used for request identity.
DEV_ORGANIZATION_ID=
DEV_DRIVER_ID=
DEV_OWNER_AUTH_USER_ID=
DEV_OWNER_EMAIL=
DEV_DRIVER_AUTH_USER_ID=
DEV_DRIVER_EMAIL=
