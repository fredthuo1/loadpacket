model OrganizationSubscription {
  organizationId String @id @map("organization_id") @db.Uuid
  state String @default("UNKNOWN") @db.VarChar(16)
  revision BigInt @default(0)
  enrolledAt DateTime? @map("enrolled_at") @db.Timestamptz(3)
  firstTrialStartedAt DateTime? @map("first_trial_started_at") @db.Timestamptz(3)
  planId String? @map("plan_id") @db.VarChar(100)
  planVersion Int? @map("plan_version")
  planSnapshot Json? @map("plan_snapshot")
  cadence String? @db.VarChar(8)
  paidPeriodStartedAt DateTime? @map("paid_period_started_at") @db.Timestamptz(3)
  paidPeriodEndsAt DateTime? @map("paid_period_ends_at") @db.Timestamptz(3)
  firstPaymentFailedAt DateTime? @map("first_payment_failed_at") @db.Timestamptz(3)
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@map("organization_subscriptions")
}

model OrganizationBillingCustomer {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  provider String @db.VarChar(32)
  environment String @db.VarChar(16)
  providerAccountId String @map("provider_account_id") @db.VarChar(200)
  externalCustomerId String @map("external_customer_id") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  links OrganizationBillingLink[]
  @@unique([id, organizationId, provider, environment, providerAccountId], map: "billing_customer_scope_key")
  @@unique([provider, environment, providerAccountId, externalCustomerId], map: "billing_customer_external_key")
  @@index([organizationId])
  @@map("organization_billing_customers")
}

model OrganizationBillingLink {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  provider String @db.VarChar(32)
  environment String @db.VarChar(16)
  providerAccountId String @map("provider_account_id") @db.VarChar(200)
  externalSubscriptionId String @map("external_subscription_id") @db.VarChar(200)
  isCurrent Boolean @default(true) @map("is_current")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  customer OrganizationBillingCustomer @relation(fields: [customerId, organizationId, provider, environment, providerAccountId], references: [id, organizationId, provider, environment, providerAccountId], onDelete: Restrict, onUpdate: NoAction, map: "billing_link_customer_scope_fk")
  events OrganizationBillingEvent[]
  @@unique([id, organizationId], map: "billing_link_tenant_key")
  @@unique([provider, environment, providerAccountId, externalSubscriptionId], map: "billing_link_external_key")
  @@index([organizationId, createdAt])
  @@map("organization_billing_links")
}

model OrganizationBillingEvent {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  linkId String? @map("link_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  source String @db.VarChar(16)
  sourceScope String @map("source_scope") @db.VarChar(512)
  sourceEventId String @map("source_event_id") @db.VarChar(200)
  kind String @db.VarChar(64)
  payloadHash String @map("payload_hash") @db.Char(64)
  schemaVersion Int @default(1) @map("schema_version")
  normalizedInput Json @map("normalized_input")
  effectiveAt DateTime @map("effective_at") @db.Timestamptz(3)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  appliedRevision BigInt? @map("applied_revision")
  beforeSnapshot Json? @map("before_snapshot")
  afterSnapshot Json? @map("after_snapshot")
  outcome String? @db.VarChar(16)
  response Json?
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  link OrganizationBillingLink? @relation(fields: [linkId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "billing_event_link_tenant_fk")
  actor User? @relation(fields: [actorId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "billing_event_actor_tenant_fk")
  buckets OrganizationUsageBucket[]
  reservations OrganizationUsageReservation[]
  grants AssignmentEntitlementGrant[]
  @@unique([id, organizationId], map: "billing_event_tenant_key")
  @@unique([source, sourceScope, sourceEventId], map: "billing_event_delivery_key")
  @@index([organizationId, receivedAt])
  @@index([outcome, receivedAt])
  @@map("organization_billing_events")
}

model OrganizationUsageBucket {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  capability String @db.VarChar(32)
  windowKey String @map("window_key") @db.VarChar(128)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(3)
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz(3)
  planVersion Int @map("plan_version")
  limit BigInt?
  used BigInt @default(0)
  reserved BigInt @default(0)
  configurationEventId String @map("configuration_event_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  configurationEvent OrganizationBillingEvent @relation(fields: [configurationEventId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "usage_bucket_config_tenant_fk")
  reservations OrganizationUsageReservation[]
  @@unique([id, organizationId], map: "usage_bucket_tenant_key")
  @@unique([organizationId, capability, windowKey], map: "usage_bucket_window_key")
  @@index([organizationId, capability, windowStartedAt])
  @@map("organization_usage_buckets")
}

model OrganizationUsageReservation {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  bucketId String @map("bucket_id") @db.Uuid
  commandEventId String @map("command_event_id") @db.Uuid
  operationKey String @map("operation_key") @db.VarChar(200)
  requestHash String @map("request_hash") @db.Char(64)
  quantity BigInt
  state String @default("RESERVED") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  finalizedAt DateTime? @map("finalized_at") @db.Timestamptz(3)
  outcomeEvidence Json? @map("outcome_evidence")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  bucket OrganizationUsageBucket @relation(fields: [bucketId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "usage_reservation_bucket_tenant_fk")
  commandEvent OrganizationBillingEvent @relation(fields: [commandEventId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "usage_reservation_event_tenant_fk")
  @@unique([id, organizationId], map: "usage_reservation_tenant_key")
  @@unique([organizationId, operationKey], map: "usage_reservation_operation_key")
  @@index([bucketId, organizationId, state])
  @@map("organization_usage_reservations")
}

model AssignmentEntitlementGrant {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  loadId String @map("load_id") @db.Uuid
  driverId String @map("driver_id") @db.Uuid
  // Historical snapshot: LoadAssignment rows may be reused after reassignment.
  assignmentId String @map("assignment_id") @db.Uuid
  assignmentGenerationKey String @map("assignment_generation_key") @db.Char(64)
  assignedAt DateTime @map("assigned_at") @db.Timestamptz(3)
  assignmentEventId String? @map("assignment_event_id") @db.Uuid
  decisionEventId String @map("decision_event_id") @db.Uuid
  subscriptionRevision BigInt @map("subscription_revision")
  policyVersion Int @map("policy_version")
  origin String @db.VarChar(32)
  evidence Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  load Load @relation(fields: [loadId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "assignment_grant_load_tenant_fk")
  driver Driver @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "assignment_grant_driver_tenant_fk")
  assignmentEvent LoadEvent? @relation(fields: [assignmentEventId, organizationId, loadId], references: [id, organizationId, loadId], onDelete: Restrict, onUpdate: NoAction, map: "assignment_grant_occurrence_fk")
  decisionEvent OrganizationBillingEvent @relation(fields: [decisionEventId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "assignment_grant_decision_tenant_fk")
  @@unique([organizationId, loadId, assignmentGenerationKey], map: "assignment_grant_generation_key")
  @@index([organizationId, driverId, loadId])
  @@map("assignment_entitlement_grants")
}

model Organization {
  billingSubscription OrganizationSubscription?
  billingCustomers OrganizationBillingCustomer[]
  billingLinks OrganizationBillingLink[]
  billingEvents OrganizationBillingEvent[]
  usageBuckets OrganizationUsageBucket[]
  usageReservations OrganizationUsageReservation[]
  assignmentEntitlements AssignmentEntitlementGrant[]
  processingRuns DocumentProcessingRun[]
  staffInvitations StaffInvitation[]
  driverSettlements DriverSettlement[]
  settlementWork DriverSettlementWork[]
  settlementItems DriverSettlementItem[]
  settlementPayments DriverSettlementPayment[]
  carrierInvoices CarrierInvoice[]
  carrierInvoiceCharges CarrierInvoiceCharge[]
  signatures DocumentSignature[]
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  dbaName String? @map("dba_name")
  mcNumber String? @map("mc_number")
  usdotNumber String? @map("usdot_number")
  phone String?
  email String?
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  city String?
  state String?
  postalCode String? @map("postal_code")
  country String @default("US")
  timezone String @default("America/Chicago")
  defaultPaymentTermsDays Int @default(30) @map("default_payment_terms_days")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  documents            Document[]
  documentVersions     DocumentVersion[]
  loads                Load[]
  loadStops            LoadStop[]
  loadDocuments        LoadDocument[]
  loadRequirements     LoadRequirement[]
  drivers              Driver[]
  loadAssignments      LoadAssignment[]
  loadEvents           LoadEvent[]
  chargeOpportunities  LoadChargeOpportunity[]
  agreements           Agreement[]
  agreementVersions    AgreementVersion[]
  agreementAcceptances AgreementAcceptance[]
  externalAccesses     ExternalTransactionAccess[]
  users                User[]
  driverInvitations    DriverInvitation[]
  organizationDocuments OrganizationDocument[]
  driverDocuments DriverDocument[]
  loadPayments LoadPayment[]
  financialTransactions FinancialTransaction[]
  financialImports FinancialImportBatch[]
  financialImportRows FinancialImportRow[]
  historicalLoads HistoricalLoadRecord[]
  financialAudit FinancialAuditEvent[]

  @@map("organizations")
}

model LoadAssignment {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  loadId         String               @map("load_id") @db.Uuid
  driverId       String               @map("driver_id") @db.Uuid
  status         LoadAssignmentStatus @default(ASSIGNED)

  assignedAt  DateTime  @default(now()) @map("assigned_at")
  acceptedAt  DateTime? @map("accepted_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  load         Load         @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@unique([organizationId, loadId])
  @@index([organizationId, driverId])
  @@index([organizationId, status])
  @@map("load_assignments")
}

model Document {
  financialTransactions FinancialTransaction[]
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  type           DocumentType
  status         DocumentStatus @default(UPLOADED)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions            DocumentVersion[]
  loadDocuments       LoadDocument[]
  chargeOpportunities LoadChargeOpportunity[]

  organizationDocument OrganizationDocument?
  driverDocument DriverDocument?

  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("documents")
}

model DocumentVersion {
  processingRuns DocumentProcessingRun[]
  driverSettlements DriverSettlement[]
  carrierInvoices CarrierInvoice[]
  signatures DocumentSignature[]
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  documentId       String   @map("document_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  originalFileName String   @map("original_file_name")
  mimeType         String   @map("mime_type")
  sizeBytes        Int      @map("size_bytes")
  checksum         String   @db.VarChar(64)
  storageKey       String   @map("storage_key")
  createdAt        DateTime @default(now()) @map("created_at")
  uploadedByUserId String? @map("uploaded_by_user_id") @db.Uuid
  uploadKey String? @map("upload_key") @db.Uuid
  issuedAt DateTime? @map("issued_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date
  uploadedBy User? @relation(fields: [uploadedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document          Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  agreementVersions AgreementVersion[]
  currentRequirements LoadRequirement[] @relation("CurrentRequirementVersion")
  reviewedRequirements LoadRequirement[] @relation("ReviewedRequirementVersion")

  @@unique([id, documentId, organizationId])
  @@unique([documentId, versionNumber])
  @@unique([id, organizationId])
  @@unique([organizationId, uploadKey])
  @@unique([organizationId, storageKey])
  @@index([organizationId, checksum])
  @@map("document_versions")
}

enum CompanyDocumentType {
  W9
  CERTIFICATE_OF_INSURANCE
  OPERATING_AUTHORITY
  PERMIT
  OTHER
}

enum DriverDocumentType {
  CDL
  MEDICAL_CERTIFICATE
  MVR
  OTHER
}

model OrganizationDocument {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  documentId String @unique @map("document_id") @db.Uuid
  type CompanyDocumentType
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([documentId, organizationId])
  @@index([organizationId, type])
  @@map("organization_documents")
}

model DriverDocument {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  driverId String @map("driver_id") @db.Uuid
  documentId String @unique @map("document_id") @db.Uuid
  type DriverDocumentType
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driver Driver @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  document Document @relation(fields: [documentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([documentId, organizationId])
  @@index([organizationId, driverId, type])
  @@map("driver_documents")
}

model Load {
  assignmentEntitlements AssignmentEntitlementGrant[]
  processingRuns DocumentProcessingRun[]
  settlementWork DriverSettlementWork[]
  carrierInvoices CarrierInvoice[]
  signatures DocumentSignature[]
  financialTransactions FinancialTransaction[]
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  status         LoadStatus @default(BOOKED)
  loadNumber     String     @map("load_number")

  brokerName    String  @map("broker_name")
  brokerContact String? @map("broker_contact")
  equipment     String?

  currency      String   @default("USD") @db.VarChar(3)
  linehaul      Decimal? @db.Decimal(12, 2)
  fuelSurcharge Decimal? @map("fuel_surcharge") @db.Decimal(12, 2)
  totalRate     Decimal  @map("total_rate") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stops        LoadStop[]
  documents    LoadDocument[]
  requirements LoadRequirement[]
  assignments  LoadAssignment[]

  events              LoadEvent[]
  chargeOpportunities LoadChargeOpportunity[]
  agreements          Agreement[]
  externalAccesses    ExternalTransactionAccess[]

  invoiceNumber         String?   @map("invoice_number")
  invoiceIssuedAt       DateTime? @map("invoice_issued_at")
  billingSubmittedAt    DateTime? @map("billing_submitted_at")
  paymentTermsDays      Int?      @map("payment_terms_days")
  paymentDueAt          DateTime? @map("payment_due_at")
  billingRecipientName  String?   @map("billing_recipient_name")
  billingRecipientEmail String?   @map("billing_recipient_email")
  paidAt                DateTime? @map("paid_at")
  amountPaid            Decimal?  @map("amount_paid") @db.Decimal(12, 2)
  payments LoadPayment[]

  @@unique([id, organizationId])
  @@unique([organizationId, loadNumber])
  @@index([organizationId, status])
  @@map("loads")
}

model LoadPayment {
  invoiceId String? @map("invoice_id") @db.Uuid
  invoice CarrierInvoice? @relation(fields: [invoiceId, organizationId, loadId], references: [id, organizationId, loadId], onDelete: Restrict, onUpdate: NoAction)
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  loadId String @map("load_id") @db.Uuid
  amount Decimal @db.Decimal(12, 2)
  currency String @db.VarChar(3)
  idempotencyKey String @map("idempotency_key") @db.VarChar(100)
  recordedByUserId String? @map("recorded_by_user_id") @db.Uuid
  recordedAt DateTime @map("recorded_at")
  createdAt DateTime @default(now()) @map("created_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  load Load @relation(fields: [loadId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy User? @relation(fields: [recordedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@unique([organizationId, loadId, idempotencyKey])
  @@index([organizationId, loadId, recordedAt])
  @@map("load_payments")
  @@index([organizationId, invoiceId, recordedAt])
}

model LoadStop {
