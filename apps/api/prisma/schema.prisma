generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DocumentProcessingRun {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  documentVersionId String @map("document_version_id") @db.Uuid
  sourceChecksum String @map("source_checksum") @db.VarChar(64)
  pipelineKey String @map("pipeline_key") @db.VarChar(64)
  requestedByUserId String @map("requested_by_user_id") @db.Uuid
  status String @default("QUEUED") @db.VarChar(16)
  attemptCount Int @default(0) @map("attempt_count")
  leaseToken String? @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime? @map("lease_expires_at")
  startedAt DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  errorCode String? @map("error_code") @db.VarChar(64)
  attempts Json @default("[]")
  result Json?
  review Json?
  reviewedByUserId String? @map("reviewed_by_user_id") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")
  createdLoadId String? @map("created_load_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  source DocumentVersion @relation(fields: [documentVersionId, documentId, organizationId], references: [id, documentId, organizationId], onDelete: Restrict, onUpdate: NoAction)
  requestedBy User @relation("ProcessingRequester", fields: [requestedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  reviewedBy User? @relation("ProcessingReviewer", fields: [reviewedByUserId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  createdLoad Load? @relation(fields: [createdLoadId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: NoAction)
  @@unique([id, organizationId])
  @@unique([organizationId, documentVersionId, pipelineKey])
  @@unique([organizationId, createdLoadId])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, createdAt])
  @@map("document_processing_runs")
}

