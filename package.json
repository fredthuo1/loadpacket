{
  "name": "loadpacket",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "packageManager": "pnpm@12.3.4",
  "description": "LoadPacket - Intelligent freight paperwork and back-office platform",
  "scripts": {
    "regression:quick": "node scripts/release-gate.cjs --scope=quick",
    "regression:full": "node scripts/release-gate.cjs --scope=full",
    "regression:live": "node scripts/release-gate.cjs --scope=live",
    "release:mobile": "node scripts/release-gate.cjs --scope=mobile",
    "release:api": "node scripts/release-gate.cjs --scope=api",
    "release:check": "node scripts/release-gate.cjs --scope=release",
    "release:full": "node scripts/release-gate.cjs --scope=full",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
